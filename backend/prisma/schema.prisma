// =============================================================================
// KAI Logistics SaaS - Prisma Schema (Multi-Tenant)
// =============================================================================
// Estrategia: Schema único compartido + tenantId en TODAS las tablas de negocio
// + Row-Level Security (RLS) en Postgres para defensa en profundidad.
// =============================================================================

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum TenantStatus {
    TRIAL          // Prueba gratuita de 10 dias
    ACTIVE         // Suscripcion pagada al dia
    PAST_DUE       // Vencida dentro del periodo de gracia (3 dias)
    SUSPENDED      // Suspendida por falta de pago
    EXPIRED        // Trial vencido sin conversion
    CANCELLED      // Cancelada por el cliente
}

enum MembershipRole {
    OWNER          // Dueno del tenant (pagador principal)
    ADMIN          // Administrador con acceso total dentro del tenant
    SALES          // Vendedor / gestor comercial
    OPERATOR       // Operador logistico
    VIEWER         // Solo lectura
}

enum MembershipStatus {
    ACTIVE
    INVITED        // Invitado por email, pendiente de aceptar
    SUSPENDED      // Suspendido dentro del tenant
}

enum PlanKey {
    BASE
    PRO
}

enum SubscriptionStatus {
    TRIAL
    ACTIVE
    PAST_DUE
    SUSPENDED
    CANCELLED
}

enum PaymentMethod {
    PAGO_MOVIL
    ZELLE
    EFECTIVO_USD
    TRANSFERENCIA
    TRANSFERENCIA_INTERNACIONAL
    BINANCE_USDT
    OTRO
}

enum UserRoleLegacy {
    // Solo para referencia historica durante la migracion. Sera removida.
    ADMIN
    SALES
}

enum ServiceType {
    DOOR_TO_DOOR
    FCL_20
    FCL_40
    FCL_40HC
    LCL
    AIR
    WAREHOUSE
    CUSTOMS
    OTHER
}

enum QuoteStatus {
    DRAFT
    SENT
    APPROVED
    REJECTED
    CONVERTED
}

enum PaymentStatus {
    PENDING
    PARTIALLY_PAID
    PAID
}

enum DeliveryNoteStatus {
    DRAFT
    DISPATCHED
    DELIVERED
    CANCELLED
}

enum ShipmentStatus {
    PENDING
    AT_ORIGIN_WAREHOUSE
    AT_ORIGIN_PORT
    ON_VESSEL
    AT_DESTINATION_PORT
    CUSTOMS_CLEARANCE
    ARRIVED
    DELIVERED
}

enum RateRegion {
    CHINA
    OTHER
}

enum NotificationType {
    INFO
    SUCCESS
    WARNING
    ALARM
}

enum AuditAction {
    CREATE
    UPDATE
    DELETE
    LOGIN
    LOGOUT
    SWITCH_TENANT
    ACTIVATE_TENANT
    SUSPEND_TENANT
    REGISTER_PAYMENT
    EXTEND_TRIAL
}

// =============================================================================
// CAPA GLOBAL (sin tenantId) - Gestion del SaaS por el super-admin
// =============================================================================

model SuperAdmin {
    id        String   @id @default(uuid())
    email     String   @unique
    password  String   // Hashed
    name      String
    isActive  Boolean  @default(true)
    totpSecret String?
    totpEnabled Boolean @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relaciones
    paymentsConfirmed Payment[]
    auditLogs          AuditLog[] @relation("AuditLogSuperAdmin")
}

model Plan {
    id        String   @id @default(uuid())
    key       PlanKey  @unique
    name      String
    priceUsd  Decimal  @db.Decimal(10, 2)
    // Limites del plan (centralizados pero duplicados aqui para queries rapidas)
    maxUsers          Int      @default(5)
    maxDocumentsMonth Int      @default(200)
    maxShipmentsActive Int     @default(80)
    whiteLabelEnabled Boolean  @default(false)
    multiCurrencyEnabled Boolean @default(true)
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relaciones
    tenants       Tenant[]
    subscriptions Subscription[]
}

// =============================================================================
// TENANT MANAGEMENT
// =============================================================================

model Tenant {
    id        String   @id @default(uuid())
    slug      String   @unique // Identificador URL (subdominio o header)
    name      String
    rif       String?  // RIF de la empresa
    status    TenantStatus @default(TRIAL)

    // Trial
    trialEndsAt DateTime?

    // Plan y suscripcion
    planId       String?
    plan         Plan?    @relation(fields: [planId], references: [id])
    subscription Subscription?

    // Configuracion (1:1)
    settings   CompanySettings?

    // Auditoria basica
    createdByUserId String?
    createdBy       User?  @relation("TenantCreatedBy", fields: [createdByUserId], references: [id])
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relaciones
    memberships Membership[]
    payments     Payment[]
    auditLogs    AuditLog[]

    @@index([status])
    @@index([trialEndsAt])
}

model User {
    id        String   @id @default(uuid())
    email     String   @unique // Unico global (login)
    password  String   // Hashed
    name      String
    phoneNumber String?
    position    String?  // Cargo (ej: Gerente de Operaciones)
    isActive  Boolean  @default(true)
    lastLoginAt DateTime?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relaciones - tenant-scoped via Membership
    memberships   Membership[]
    notifications Notification[] @relation("NotificationTargetUser")
    createdTenants Tenant[]      @relation("TenantCreatedBy")

    // Relaciones legacy tenant-scoped (sin back-ref en User)
    quotesCreated     Quote[]               @relation("QuoteCreatedBy")
    shipmentsHandled  Shipment[]            @relation("ShipmentHandler")
    shipmentsAsVendedor Shipment[]          @relation("ShipmentVendedor")
    payablesAsEmployee Payable[]            @relation("EmployeePayables")
    clientAssignments  ClientAssignment[]
    clientsUpdated     Client[]             @relation("ClientUpdatedByUser")
    ratesUpdated       Rate[]               @relation("RateUpdatedBy")
}

model Membership {
    id        String   @id @default(uuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    tenantId  String
    tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

    role      MembershipRole
    status    MembershipStatus @default(ACTIVE)

    invitedByUserId String?
    invitedAt       DateTime?
    joinedAt        DateTime  @default(now())

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, tenantId]) // Un user solo tiene una membresia por tenant
    @@index([tenantId])
    @@index([userId])
    @@index([status])
}

model Subscription {
    id        String   @id @default(uuid())

    tenantId  String   @unique // 1:1 con Tenant (la suscripcion activa)
    tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

    planId    String
    plan      Plan     @relation(fields: [planId], references: [id])

    status    SubscriptionStatus @default(TRIAL)
    startDate DateTime @default(now())

    currentPeriodStart DateTime
    currentPeriodEnd   DateTime
    nextPaymentDueAt   DateTime?

    // Historial de cambios de plan
    previousPlanId String?

    cancelledAt DateTime?
    cancelReason String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([status])
    @@index([currentPeriodEnd])
}

model Payment {
    id        String   @id @default(uuid())

    tenantId  String
    tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

    amountUsd Decimal  @db.Decimal(10, 2)
    method    PaymentMethod
    reference String?  // Numero de referencia del pago
    notes     String?  @db.Text

    periodStart DateTime
    periodEnd   DateTime

    // Confirmacion por el super-admin
    confirmedById String?
    confirmedBy   SuperAdmin? @relation(fields: [confirmedById], references: [id])
    confirmedAt   DateTime?

    createdAt DateTime @default(now())

    @@index([tenantId])
    @@index([periodStart, periodEnd])
    @@index([confirmedAt])
}

model CompanySettings {
    id        String   @id @default(uuid())

    tenantId  String   @unique
    tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

    // Branding - Defaults neutros para SaaS
    companyName String  @default("Mi Empresa")
    rif         String?
    logoUrl     String?
    companyAddress String?
    companyPhone   String?

    // Theme Customization
    primaryColor   String @default("#1E40AF") // Azul neutro
    secondaryColor String @default("#F59E0B") // Acento neutro

    // Document Info (PDF headers/footers)
    headerText String?
    footerText String?

    // PDF Background Images (rutas de archivos subidos)
    quoteBgUrl        String?
    noticeBgUrl       String?
    deliveryNoteBgUrl String?
    receiptBgUrl      String?
    rateBgUrl         String?

    // Texto de informacion de pago para PDF de Avisos de Cobro (default neutro)
    paymentInfo String? @default("Banco Ejemplo\nCuenta: 0102-0000-00-0000000000\nTitular: Razon Social Ejemplo C.A.\nRIF: J-00000000-0")

    updatedAt DateTime @updatedAt
    createdAt DateTime @default(now())
}

// =============================================================================
// AUDITORIA
// =============================================================================

model AuditLog {
    id        String   @id @default(uuid())

    tenantId  String?
    tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

    // Actor: user del tenant o super-admin
    userId    String?
    superAdminId String?
    superAdmin   SuperAdmin? @relation("AuditLogSuperAdmin", fields: [superAdminId], references: [id], onDelete: SetNull)

    action    AuditAction
    resourceType String?  // Ej: "Client", "Quote", "Payment"
    resourceId   String?

    before    Json?
    after     Json?
    metadata  Json?     // Info adicional (cambios de plan, ext de trial, etc.)

    ip        String?
    userAgent String?  @db.Text

    createdAt DateTime @default(now())

    @@index([tenantId, createdAt])
    @@index([userId])
    @@index([superAdminId])
    @@index([action])
    @@index([resourceType, resourceId])
}

// =============================================================================
// CATALOGOS TENANT-SCOPED
// =============================================================================

model Service {
    id        String   @id @default(uuid())

    tenantId  String
    code      String   // Codigo internacional o interno (unico por tenant)
    name      String
    type      ServiceType
    notes     String?
    isActive  Boolean  @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    rates             ServiceRate[]
    items             QuoteItem[]
    paymentNoticeItems PaymentNoticeItem[]

    @@unique([tenantId, code])
    @@index([tenantId])
    @@index([type])
}

model Zone {
    id        String   @id @default(uuid())

    tenantId  String
    internalCode String
    name      String
    description String?
    isActive  Boolean  @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    rates        ServiceRate[]
    quoteItems   QuoteItem[]
    paymentNoticeItems PaymentNoticeItem[]

    @@unique([tenantId, internalCode])
    @@index([tenantId])
}

model Port {
    id        String   @id @default(uuid())

    tenantId  String
    code      String
    name      String
    isActive  Boolean  @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([tenantId, code])
    @@index([tenantId])
}

model Country {
    id        String   @id @default(uuid())

    tenantId  String
    name      String
    code      String?  // Codigo ISO opcional (ej: "US", "MX")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    rates Rate[]

    @@unique([tenantId, name])
    @@index([tenantId])
}

model ShippingLine {
    id        String   @id @default(uuid())

    tenantId  String
    name      String
    code      String?  // Codigo opcional (ej: MSC, CMA, COSCO)
    isActive  Boolean  @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    shipments        Shipment[]
    quoteItems       QuoteItem[]
    noticeItems      PaymentNoticeItem[]
    rates            Rate[]

    @@unique([tenantId, name])
    @@index([tenantId])
}

model AirLine {
    id        String   @id @default(uuid())

    tenantId  String
    name      String
    code      String?  // Codigo IATA (ej: AA, DL, LA)
    isActive  Boolean  @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    shipments Shipment[]
    quoteItems QuoteItem[]
    noticeItems PaymentNoticeItem[]

    @@unique([tenantId, name])
    @@index([tenantId])
}

model D2DItem {
    id          String   @id @default(uuid())

    tenantId    String
    description String

    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    deliveryNoteItems DeliveryNoteItem[]
    shipmentItems     D2DShipmentItem[]

    @@unique([tenantId, description])
    @@index([tenantId])
}

model SvcProvider {
    id        String   @id @default(uuid())

    tenantId  String
    name      String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    payables Payable[]

    @@unique([tenantId, name])
    @@index([tenantId])
}

// =============================================================================
// CLIENTES Y ALIADOS
// =============================================================================

model Client {
    id        String   @id @default(uuid())

    tenantId  String
    internalCode String
    name      String
    rifOrId   String  // RIF o Cedula
    email     String
    phone     String  // Telefono
    address   String
    deliveryAddress String?
    contactPerson  String
    referencePoint String?

    clientDetails    String?  // Descripcion de lo que hace o pide comunmente
    deactivationNote String?  @db.Text // Nota al desactivar
    creditBalance    Decimal  @default(0) @db.Decimal(10, 2)

    isActive  Boolean  @default(true)
    deletedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    updatedById String?
    updatedBy   User?   @relation("ClientUpdatedByUser", fields: [updatedById], references: [id])

    quotes         Quote[]
    paymentNotices PaymentNotice[]
    receivables    Receivable[]
    deliveryNotes  DeliveryNote[]
    receipts       PaymentReceipt[]
    shipments      Shipment[]      @relation("ShipmentClient")
    clientAssignments ClientAssignment[]

    @@unique([tenantId, internalCode])
    @@unique([tenantId, rifOrId])
    @@unique([tenantId, phone])
    @@index([tenantId])
    @@index([deletedAt])
}

model ClientAssignment {
    id        String   @id @default(uuid())
    clientId  String
    client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())

    @@unique([clientId, userId])
    @@index([clientId])
    @@index([userId])
}

model Ally {
    id        String   @id @default(uuid())

    tenantId  String
    internalCode String
    name      String
    rifOrId   String?
    contactInfo String?
    address   String?

    isActive  Boolean  @default(true)
    deletedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    serviceRates       ServiceRate[]
    rates              Rate[]
    payables           Payable[]
    quoteItems         QuoteItem[]
    paymentNoticeItems PaymentNoticeItem[]
    shipmentsFCL       Shipment[] @relation("ShipmentAlly")
    shipmentsD2D       Shipment[] @relation("ShipmentD2DAliado")

    @@unique([tenantId, internalCode])
    @@unique([tenantId, rifOrId])
    @@index([tenantId])
}

// =============================================================================
// TARIFARIO
// =============================================================================

model ServiceRate {
    id        String   @id @default(uuid())

    tenantId  String

    allyId    String
    ally      Ally     @relation(fields: [allyId], references: [id])

    serviceId String
    service   Service  @relation(fields: [serviceId], references: [id])

    zoneId    String?
    zone      Zone?    @relation(fields: [zoneId], references: [id])

    costPrice Decimal  @db.Decimal(10, 2)
    salePrice Decimal  @db.Decimal(10, 2)

    originPort       String?
    destinationPort  String?
    shippingLine     String?

    validFrom  DateTime  @default(now())
    validUntil DateTime?
    currency   String    @default("USD")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([tenantId, allyId, serviceId, zoneId])
    @@index([tenantId])
}

model Rate {
    id        String   @id @default(uuid())

    tenantId  String
    region    RateRegion @default(CHINA)

    allyId    String
    ally      Ally     @relation(fields: [allyId], references: [id])

    countryId String?
    country   Country? @relation(fields: [countryId], references: [id])

    originPortIds      String[]
    destinationPortIds String[]

    cost20ft  Decimal  @db.Decimal(10, 2)
    cost40ft  Decimal  @db.Decimal(10, 2)

    bankFee     Decimal?  @db.Decimal(10, 2)
    profitYaho  Decimal?  @db.Decimal(10, 2)
    profitIS    Decimal?  @db.Decimal(10, 2)

    sale20HC  Decimal  @db.Decimal(10, 2)
    sale40HC  Decimal  @db.Decimal(10, 2)

    shippingLineId String?
    shippingLine   ShippingLine? @relation(fields: [shippingLineId], references: [id])

    freeDays   Int      @default(21)
    validFrom  DateTime @default(now())
    validUntil DateTime

    isActive  Boolean  @default(true)
    deletedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    updatedById String?
    updatedBy   User?   @relation("RateUpdatedBy", fields: [updatedById], references: [id])

    @@index([tenantId, region, deletedAt])
    @@index([tenantId, allyId])
    @@index([tenantId, countryId])
    @@index([tenantId, isActive])
    @@index([tenantId, validFrom])
    @@index([tenantId, validUntil])
}

// =============================================================================
// OPERACIONES (COTIZACIONES Y NOTAS DE ENTREGA)
// =============================================================================

model Quote {
    id        String   @id @default(uuid())

    tenantId  String
    number    Int
    date      DateTime @default(now())
    validUntil DateTime?
    status    QuoteStatus @default(DRAFT)

    clientId  String
    client    Client   @relation(fields: [clientId], references: [id])

    userId    String   // Vendedor que la creo
    user      User     @relation("QuoteCreatedBy", fields: [userId], references: [id])

    totalAmount Decimal @db.Decimal(10, 2)
    currency    String  @default("USD")
    notes       String?
    showNotesToClient Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    items         QuoteItem[]
    paymentNotice PaymentNotice?
    deliveryNotes DeliveryNote[]

    @@unique([tenantId, number])
    @@index([tenantId])
    @@index([tenantId, status])
    @@index([tenantId, createdAt])
}

model QuoteItem {
    id        String   @id @default(uuid())

    tenantId  String

    quoteId   String
    quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

    serviceId String
    service   Service  @relation(fields: [serviceId], references: [id])

    quantity   Decimal @db.Decimal(10, 2)
    unitPrice  Decimal @db.Decimal(10, 2)
    totalPrice Decimal @db.Decimal(10, 2)

    description String?

    allyId    String?
    ally      Ally?   @relation(fields: [allyId], references: [id])

    zoneId    String?
    zone      Zone?   @relation(fields: [zoneId], references: [id])

    originPort String?
    destinationPort String?

    shippingLineId String?
    shippingLine   ShippingLine? @relation(fields: [shippingLineId], references: [id])

    airLineId  String?
    airLine    AirLine? @relation(fields: [airLineId], references: [id])

    @@index([tenantId])
    @@index([quoteId])
}

model DeliveryNote {
    id        String   @id @default(uuid())

    tenantId  String
    number    Int
    date      DateTime @default(now())
    status    DeliveryNoteStatus @default(DRAFT)

    warehouseNumber String

    clientId  String
    client    Client   @relation(fields: [clientId], references: [id])

    quoteId   String?
    quote     Quote?   @relation(fields: [quoteId], references: [id])

    deliveredTo     String?
    contactPhone    String?
    deliveryAddress String?
    notes           String?  @db.Text

    deletedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    items DeliveryNoteItem[]

    @@unique([tenantId, number])
    @@index([tenantId])
    @@index([tenantId, deletedAt])
}

model DeliveryNoteItem {
    id        String   @id @default(uuid())

    tenantId  String

    deliveryNoteId String
    deliveryNote   DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)

    d2dItemId String?
    d2dItem   D2DItem? @relation(fields: [d2dItemId], references: [id])

    description String
    quantity    Decimal @db.Decimal(10, 2)
    weight      Decimal? @db.Decimal(10, 2)
    cbm         Decimal? @db.Decimal(10, 3)

    @@index([tenantId])
    @@index([deliveryNoteId])
}

model PaymentNotice {
    id        String   @id @default(uuid())

    tenantId  String
    number    Int
    issueDate DateTime @default(now())

    quoteId   String?  @unique
    quote     Quote?   @relation(fields: [quoteId], references: [id])

    clientId  String
    client    Client   @relation(fields: [clientId], references: [id])

    totalAmount Decimal @db.Decimal(10, 2)
    currency    String  @default("USD")
    notes       String? @db.Text

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    items    PaymentNoticeItem[]
    tracking Shipment?
    receivable Receivable?

    @@unique([tenantId, number])
    @@index([tenantId])
    @@index([tenantId, createdAt])
}

model PaymentNoticeItem {
    id        String   @id @default(uuid())

    tenantId  String

    paymentNoticeId String
    paymentNotice   PaymentNotice @relation(fields: [paymentNoticeId], references: [id], onDelete: Cascade)

    serviceId String?
    service   Service? @relation(fields: [serviceId], references: [id])

    allyId    String?
    ally      Ally?    @relation(fields: [allyId], references: [id])

    zoneId    String?
    zone      Zone?    @relation(fields: [zoneId], references: [id])

    shippingLineId String?
    shippingLine   ShippingLine? @relation(fields: [shippingLineId], references: [id])

    airLineId  String?
    airLine    AirLine? @relation(fields: [airLineId], references: [id])

    description String
    quantity    Decimal @db.Decimal(10, 2)
    unitPrice   Decimal @db.Decimal(10, 2)
    totalPrice  Decimal @db.Decimal(10, 2)

    @@index([tenantId])
    @@index([paymentNoticeId])
}

// =============================================================================
// OPERACIONES (SHIPPING / TRACKING)
// =============================================================================

model Shipment {
    id        String   @id @default(uuid())

    tenantId  String
    number    Int

    paymentNoticeId String? @unique
    paymentNotice   PaymentNotice? @relation(fields: [paymentNoticeId], references: [id])

    type      String   // "FCL", "D2D" o "CONSOLIDADO"

    blNumber      String?
    whNumber      String?
    bookingNumber String?

    shippingLineId String?
    shippingLineRel ShippingLine? @relation(fields: [shippingLineId], references: [id])

    status          ShipmentStatus @default(PENDING)
    currentLocation String?
    arrivalDate     DateTime?

    tracking   String?
    pVol       Decimal? @db.Decimal(10, 2)
    pMax       Decimal? @db.Decimal(10, 2)
    value      Decimal? @db.Decimal(10, 2)
    dimensions String?

    clientId   String?
    clientRel  Client? @relation("ShipmentClient", fields: [clientId], references: [id])
    clientName String?

    vendedorId String?
    vendedor   User?   @relation("ShipmentVendedor", fields: [vendedorId], references: [id])

    airLineId  String?
    airLine    AirLine? @relation(fields: [airLineId], references: [id])

    originPort String?
    destPort   String?
    etd        DateTime?
    eta        DateTime?
    transitTime Int?
    aliadoId   String?
    aliado     Ally?    @relation("ShipmentAlly", fields: [aliadoId], references: [id])

    containers ShipmentContainer[]

    weight    Decimal? @db.Decimal(10, 2)
    quantity  Int?
    cbm       Decimal? @db.Decimal(10, 2)
    cst       String?
    consolidadoManual String?
    transportType    String?
    d2dEta           DateTime?
    deliveryPlace    String?
    d2dTransitTime   Int?
    d2dAliadoId      String?
    d2dAliado        Ally?    @relation("ShipmentD2DAliado", fields: [d2dAliadoId], references: [id])

    d2dShipmentItems D2DShipmentItem[]

    consolidadoNumber      String?
    arrivalPort            String?
    consolidadoTransitTime Int?

    updatedById String
    updatedBy   User   @relation("ShipmentHandler", fields: [updatedById], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    deletedAt DateTime?

    @@unique([tenantId, number])
    @@index([tenantId])
    @@index([tenantId, status])
    @@index([tenantId, eta])
    @@index([tenantId, deletedAt])
}

model ShipmentContainer {
    id        String   @id @default(uuid())

    tenantId  String

    shipmentId String
    shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

    containerType String
    quantity      Int     @default(1)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([tenantId])
    @@index([shipmentId])
}

model D2DShipmentItem {
    id        String   @id @default(uuid())

    tenantId  String

    shipmentId String
    shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

    d2dItemId String
    d2dItem   D2DItem  @relation(fields: [d2dItemId], references: [id])

    createdAt DateTime @default(now())

    @@index([tenantId])
    @@index([shipmentId])
    @@index([d2dItemId])
}

// =============================================================================
// FINANZAS
// =============================================================================

model Receivable {
    id        String   @id @default(uuid())

    tenantId  String
    number    Int

    paymentNoticeId String? @unique
    paymentNotice   PaymentNotice? @relation(fields: [paymentNoticeId], references: [id])

    clientId  String
    client    Client   @relation(fields: [clientId], references: [id])

    manualNotes String? @db.Text

    totalAmount Decimal @db.Decimal(10, 2)
    currency    String  @default("USD")
    paidAmount  Decimal @default(0) @db.Decimal(10, 2)
    balance     Decimal @db.Decimal(10, 2)
    status      PaymentStatus @default(PENDING)

    payments PaymentTransaction[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    deletedAt DateTime?

    @@unique([tenantId, number])
    @@index([tenantId])
    @@index([tenantId, status])
    @@index([tenantId, deletedAt])
}

model Payable {
    id        String   @id @default(uuid())

    tenantId  String
    number    Int
    invoiceNr String?

    allyId    String?
    ally      Ally?   @relation(fields: [allyId], references: [id])

    svcProviderId String?
    svcProvider   SvcProvider? @relation(fields: [svcProviderId], references: [id])

    employeeUserId String?
    employeeUser   User?  @relation("EmployeePayables", fields: [employeeUserId], references: [id])

    description String
    currency    String  @default("USD")
    amount      Decimal @db.Decimal(10, 2)
    paidAmount  Decimal @default(0) @db.Decimal(10, 2)
    balance     Decimal @db.Decimal(10, 2)
    status      PaymentStatus @default(PENDING)

    relatedOperationId String?

    dueDate DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    deletedAt DateTime?

    payments PayableTransaction[]

    @@unique([tenantId, number])
    @@index([tenantId])
    @@index([tenantId, status])
    @@index([tenantId, dueDate])
    @@index([tenantId, deletedAt])
}

model PayableTransaction {
    id        String   @id @default(uuid())

    tenantId  String

    payableId String
    payable   Payable  @relation(fields: [payableId], references: [id])

    amount   Decimal @db.Decimal(10, 2)
    date     DateTime @default(now())
    method   String
    reference String?
    notes    String? @db.Text

    createdAt DateTime @default(now())

    @@index([tenantId])
    @@index([payableId])
}

model PaymentTransaction {
    id        String   @id @default(uuid())

    tenantId  String

    receivableId String
    receivable   Receivable @relation(fields: [receivableId], references: [id])

    amount   Decimal @db.Decimal(10, 2)
    overpaymentApplied Decimal? @db.Decimal(10, 2)
    date     DateTime @default(now())
    method   String
    reference String?
    notes    String? @db.Text

    receipt PaymentReceipt?

    createdAt DateTime @default(now())

    @@index([tenantId])
    @@index([receivableId])
}

model PaymentReceipt {
    id        String   @id @default(uuid())

    tenantId  String
    receiptNumber Int

    paymentTransactionId String @unique
    paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id])

    clientId String
    client   Client  @relation(fields: [clientId], references: [id])

    amount        Decimal @db.Decimal(10, 2)
    paymentMethod String
    reference     String?

    issuedBy String

    createdAt DateTime @default(now())

    @@unique([tenantId, receiptNumber])
    @@index([tenantId])
}

// =============================================================================
// NOTIFICACIONES
// =============================================================================

model Notification {
    id        String   @id @default(uuid())

    tenantId  String
    title     String
    message   String
    type      NotificationType @default(INFO)
    isRead    Boolean  @default(false)

    targetUserId String?
    targetUser   User?   @relation("NotificationTargetUser", fields: [targetUserId], references: [id])

    targetRoles String[] @default([])

    entityType String?
    entityId   String?

    createdAt DateTime @default(now())

    @@index([tenantId])
    @@index([tenantId, isRead])
    @@index([tenantId, targetUserId])
    @@index([tenantId, createdAt])
}
