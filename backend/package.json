{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend ERP Import Services",
  "main": "src/server.js",
  "scripts": {
    "build": "prisma generate && prisma migrate deploy",
    "build:reset": "prisma generate && prisma migrate reset --force --skip-seed",
    "build:seed": "node prisma/seed.js",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "erp",
    "logistics",
    "backend"
  ],
  "author": "NIKdev",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "node-cron": "^4.6.0",
    "pg": "^8.16.3",
    "react-international-phone": "^4.8.0"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.2",
    "nodemon": "^3.1.11",
    "prisma": "^6.19.2"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
