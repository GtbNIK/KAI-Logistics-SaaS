# =============================================================================
# KAI Logistics SaaS - Backend Environment Variables (TEMPLATE)
# =============================================================================
# Copia este archivo como `.env` y rellena los valores reales.
#
#   cp .env.example .env
#
# NUNCA commitees el archivo `.env` (ya esta en .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos (Supabase PostgreSQL)
# -----------------------------------------------------------------------------
# Opcion A: Conexion directa a Supabase (recomendado para migraciones)
# Formato: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Encuentras tu PROJECT_REF y PASSWORD en: Supabase Dashboard > Settings > Database
DATABASE_URL="postgresql://postgres:TU_PASSWORD@db.TU_PROJECT_REF.supabase.co:5432/postgres"

# Opcion B: Conexion via Pooler (recomendado para el backend en produccion)
# Formato: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# DATABASE_URL="postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# -----------------------------------------------------------------------------
# JWT (Autenticacion)
# -----------------------------------------------------------------------------
# Genera un secreto seguro con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="PEGA_AQUI_TU_SECRETO_DE_32_BYTES"
JWT_EXPIRES_IN="1h"

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Frontend (CORS)
# -----------------------------------------------------------------------------
# URL del frontend que hara requests. Multiples separadas por coma.
# Dev: http://localhost:5173
# Prod: https://tu-dominio.com
FRONTEND_URL="http://localhost:5173"

# -----------------------------------------------------------------------------
# Supabase (Storage de archivos, opcional)
# -----------------------------------------------------------------------------
# Solo si usas Supabase Storage para imagenes/PDFs.
# Encuéntralo en: Supabase Dashboard > Settings > API
SUPABASE_URL="https://TU_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_KEY="TU_SERVICE_ROLE_KEY"

# -----------------------------------------------------------------------------
# Zona horaria (opcional, default America/Caracas)
# -----------------------------------------------------------------------------
# TZ="America/Caracas"
